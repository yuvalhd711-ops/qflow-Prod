      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e1\u05e0\u05d9\u05e3"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05d5\u05e8 (\u05d6\u05d4\u05d4 \u05dc\u05e9\u05dd \u05d4\u05de\u05d7\u05dc\u05e7\u05d4)"
    },
    "seq_counter": {
      "type": "integer",
      "default": 0,
      "description": "\u05de\u05d5\u05e0\u05d4 \u05e2\u05d5\u05e7\u05d1 \u05dc\u05de\u05e1\u05e4\u05e8\u05d9 \u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05dd"
