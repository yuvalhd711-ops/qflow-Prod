    "avg_service_time_seconds": {
      "type": "integer",
      "default": 180,
      "description": "\u05d6\u05de\u05df \u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05de\u05d5\u05e6\u05e2 \u05d1\u05e9\u05e0\u05d9\u05d5\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05d5\u05e8 \u05e4\u05e2\u05d9\u05dc"
    }
  },
